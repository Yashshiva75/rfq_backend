generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RfqStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
}

enum QuotationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role               Role                @relation(fields: [roleId], references: [id])
  createdRfqs        RFQ[]               @relation("UserCreatedRFQs")
  quotations         Quotation[]         @relation("VendorQuotations")
  quotationRevisions QuotationRevision[]
  files              File[]
  histories          History[]

  @@index([roleId])
}

// =================================== ROLE BASED ACCESS CONTROL TABLES ============================ //

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ========================================== RFQ FUNCTIONALITIES ================================= //

model RFQ {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  location       String
  currency       String    @default("USD") @db.VarChar(3)
  optionalBudget Decimal?  @db.Decimal(12, 2)
  deadline       DateTime
  totalPriceRfq  Decimal?  @db.Decimal(12, 2)
  status         RfqStatus @default(DRAFT)
  createdById    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy  User          @relation("UserCreatedRFQs", fields: [createdById], references: [id])
  categories RFQCategory[]
  lineItems  RFQLineItem[]
  quotations Quotation[]
  files      File[]
  history    History[]

  @@index([createdById])
  @@index([status])
}

model Category {
  id   Int           @id @default(autoincrement())
  name String        @unique
  rfqs RFQCategory[]
}

model RFQCategory {
  id         Int @id @default(autoincrement())
  rfqId      Int
  categoryId Int

  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([rfqId, categoryId])
  @@index([categoryId])
}

model RFQLineItem {
  id             Int      @id @default(autoincrement())
  rfqId          Int
  name           String
  description    String?
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  specifications String?
  createdAt      DateTime @default(now())

  rfq            RFQ                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotationItems QuotationLineItem[]

  @@index([rfqId])
}

// -------------------- QUOTATION --------------------

model Quotation {
  id              Int             @id @default(autoincrement())
  rfqId           Int
  vendorId        Int
  quoteNo         String          @unique
  currency        String          @default("USD") @db.VarChar(3)
  deliveryTime    String?
  status          QuotationStatus @default(SUBMITTED)
  totalPriceQuote Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfq       RFQ                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor    User                @relation("VendorQuotations", fields: [vendorId], references: [id])
  lineItems QuotationLineItem[]
  revisions QuotationRevision[]
  files     File[]
  history   History[]

  @@unique([rfqId, vendorId])
  @@index([vendorId])
  @@index([status])
}

model QuotationLineItem {
  id            Int      @id @default(autoincrement())
  quotationId   Int
  rfqLineItemId Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal? @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())

  quotation   Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineItem RFQLineItem @relation(fields: [rfqLineItemId], references: [id])

  @@unique([quotationId, rfqLineItemId])
  @@index([rfqLineItemId])
}

// -------------------- QUOTATION REVISIONS --------------------

model QuotationRevision {
  id          Int      @id @default(autoincrement())
  quotationId Int
  revisionNo  Int
  totalPrice  Decimal  @db.Decimal(12, 2)
  changedAt   DateTime @default(now())
  changedBy   Int
  snapshot    Json?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [changedBy], references: [id])

  @@unique([quotationId, revisionNo])
  @@index([changedBy])
}

// -------------------- FILES --------------------

model File {
  id          Int      @id @default(autoincrement())
  fileName    String
  storageKey  String
  mimeType    String
  uploadedBy  Int
  rfqId       Int?
  quotationId Int?
  createdAt   DateTime @default(now())

  rfq       RFQ?       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [uploadedBy], references: [id])

  @@index([rfqId])
  @@index([quotationId])
  @@index([uploadedBy])
}

// -------------------- HISTORY --------------------

model History {
  id          Int      @id @default(autoincrement())
  rfqId       Int?
  quotationId Int?
  updatedBy   Int
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  rfq       RFQ?       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [updatedBy], references: [id])

  @@index([rfqId])
  @@index([quotationId])
  @@index([updatedBy])
}
